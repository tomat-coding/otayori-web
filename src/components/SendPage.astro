---
import { SEND_HANDOUT_URLS, withBase } from "../config";
import type { Copy } from "../i18n/ja";
import type { SendCopy } from "../i18n/pages/send";
import Base from "../layouts/Base.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

// The teacher's send page. The link's token is the URL's #fragment, so it never reaches a server log, and no-referrer
// keeps the page's address out of every request it makes. All behaviour is in src/scripts/send.ts.

interface Props {
  copy: Copy;
  send: SendCopy;
}

const { copy, send } = Astro.props;
const t = send.text;
const functionOrigins = Object.values(SEND_HANDOUT_URLS)
  .map((url) => new URL(url).origin)
  .join(" ");
const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  `connect-src ${functionOrigins}`,
  "base-uri 'none'",
  "form-action 'none'",
].join("; ");
// Read by the script; "<" is escaped so no text can close the tag.
const textJson = JSON.stringify(t).replace(/</g, "\\u003c");
---

<Base
  copy={copy}
  title={send.title}
  description={send.description}
  ogTitle={send.heading}
  alternates={{ ja: "/send/", en: "/en/send/" }}
  noindex
  referrer="no-referrer"
  csp={csp}
>
  <Header copy={copy} switchHref={send.switchHref} bare />
  <main id="main" class="send">
    <h1>{send.heading}</h1>
    <p id="send-for" class="for"></p>
    <p id="send-status" class="status" role="status"></p>
    <p id="send-alert" class="alert" role="alert"></p>
    <noscript>
      <p class="alert">{t.noscript}</p>
    </noscript>

    <form id="send-form" class="form" hidden>
      <label class="drop" id="send-drop">
        <input
          id="send-files"
          class="visually-hidden"
          type="file"
          multiple
          accept="application/pdf,image/jpeg,image/png,image/heic,image/heif,.pdf,.jpg,.jpeg,.png,.heic,.heif"
        />
        <svg aria-hidden="true" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path
            d="M12 16V4m0 0-4.5 4.5M12 4l4.5 4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span class="pick">{t.choose}</span>
        <span class="hint">{t.readyBody}</span>
      </label>

      <ul id="send-list" class="files" aria-label={t.files}></ul>

      <div class="field">
        <label for="send-name">{t.nameLabel}</label>
        <input id="send-name" type="text" maxlength="60" autocomplete="name" />
      </div>
      <div class="field">
        <label for="send-message">{t.messageLabel}</label>
        <textarea id="send-message" maxlength="500" rows="4"></textarea>
      </div>

      <button id="send-button" class="button" type="submit">
        {t.send}
      </button>
      <p class="privacy">
        {t.privacyNote}
        <a href={withBase(send.privacyHref)} target="_blank" rel="noopener">
          {t.privacyLink}
        </a>
      </p>
    </form>
  </main>
  <Footer footer={copy.footer} />
  <script id="send-text" type="application/json" set:html={textJson} />
</Base>

<script>
  import "../scripts/send";
</script>

<style>
  /* The page is short, mostly a message or a small form, so the footer is held at the bottom of the window. */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-block-size: 100svh;
  }

  .send {
    flex: 1 0 auto;
    inline-size: 100%;
    max-inline-size: 640px;
    margin-inline: auto;
    padding: 32px var(--gutter) 64px;
  }

  h1 {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem);
  }

  /* Says whose link this is. It carries the parent's own label, in any characters, so it keeps the body font. */
  .for:not(:empty) {
    margin-block-start: 8px;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .status:not(:empty) {
    margin-block-start: 12px;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .status.done {
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--teal-soft);
    color: var(--teal-deep);
    font-weight: 700;
  }

  .alert:not(:empty) {
    margin-block-start: 16px;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--coral-soft);
    color: var(--coral-ink);
    font-weight: 500;
    white-space: pre-line;
  }

  .form {
    display: grid;
    gap: 20px;
    margin-block-start: 24px;
  }

  .form[hidden] {
    display: none;
  }

  .drop {
    display: grid;
    gap: 8px;
    justify-items: center;
    padding: 32px 20px;
    border: 2px dashed var(--teal-ring);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--teal-deep);
    text-align: center;
    cursor: pointer;
  }

  .drop:hover,
  .drop.over {
    background: var(--teal-soft);
  }

  .drop:has(input:focus-visible) {
    outline: 3px solid var(--amber);
    outline-offset: 3px;
  }

  .pick {
    display: inline-flex;
    align-items: center;
    min-block-size: 48px;
    padding-inline: 24px;
    border-radius: 999px;
    background: var(--teal);
    color: #fff;
    font-weight: 700;
  }

  .hint {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .files {
    display: grid;
    gap: 8px;
  }

  .files:empty {
    display: none;
  }

  .files :global(li) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    align-items: center;
    padding: 10px 12px 10px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    line-height: 1.5;
  }

  .files :global(.name) {
    min-inline-size: 0;
    overflow: hidden;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .files :global(.meta) {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .files :global(.sent .meta) {
    color: var(--teal-deep);
    font-weight: 700;
  }

  .files :global(.rejected .meta) {
    color: var(--coral-ink);
  }

  .files :global(progress) {
    grid-column: 1 / -1;
    inline-size: 100%;
    block-size: 8px;
    accent-color: var(--teal);
  }

  .files :global(button) {
    grid-row: 1 / span 2;
    grid-column: 2;
    min-block-size: 44px;
    padding-inline: 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--ground);
    color: var(--ink);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .field {
    display: grid;
    gap: 6px;
  }

  .field label {
    font-weight: 700;
  }

  .field input,
  .field textarea {
    inline-size: 100%;
    padding: 12px 14px;
    border: 1px solid #b9ad9e;
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: max(1rem, 16px); /* 16px or more, so iPhones don't zoom in on focus */
  }

  .field textarea {
    resize: vertical;
  }

  .button {
    min-block-size: 56px;
    border: 0;
    border-radius: 999px;
    background: var(--teal);
    color: #fff;
    font: inherit;
    font-size: 1.125rem;
    font-weight: 700;
    cursor: pointer;
  }

  .button:hover {
    background: var(--teal-deep);
  }

  .button:disabled {
    background: var(--muted);
    cursor: progress;
  }

  .privacy {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .privacy a {
    color: var(--teal-deep);
  }
</style>
