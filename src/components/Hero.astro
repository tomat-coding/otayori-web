---
import { LINKS } from "../config";
import type { Copy } from "../i18n/ja";
import calendar from "../assets/screens/android-calendar.png";
import home from "../assets/screens/ios-home.png";
import desktop from "../assets/screens/desktop-home.png";
import PhoneFrame from "./PhoneFrame.astro";
import Screen from "./Screen.astro";
import StoreBadges from "./StoreBadges.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const phoneSizes = "(min-width: 1080px) 250px, 24vw";
---

<section id="top">
  <div class="band">
    <div class="ring" aria-hidden="true"></div>
    <div class="dot coral" aria-hidden="true"></div>
    <div class="dot amber" aria-hidden="true"></div>
    <div class="intro">
      <a class="pill" href="#early-access">
        {copy.hero.pill}
      </a>
      <p class="kicker">{copy.hero.kicker}</p>
      <h1>
        {copy.hero.title.map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      <p class="lead">{copy.hero.lead}</p>
      <StoreBadges badges={copy.badges} lang={copy.lang} center />
      <p class="reassure">
        {copy.hero.reassure}
        <br />
        <a href={LINKS.macDownload}>{copy.badges.mac}</a>
      </p>
    </div>
  </div>
  <div class="devices">
    <div class="stage">
      <div class="laptop">
        <div class="lid">
          <Screen
            src={desktop}
            alt={copy.hero.alts.desktop}
            widths={[640, 960, 1440]}
            sizes="(min-width: 1080px) 816px, 80vw"
            priority
          />
        </div>
        <div class="base" aria-hidden="true"></div>
      </div>
      <div class="iphone">
        <PhoneFrame src={home} alt={copy.hero.alts.home} sizes={phoneSizes} />
      </div>
      <div class="android">
        <PhoneFrame src={calendar} alt={copy.hero.alts.calendar} kind="android" sizes={phoneSizes} />
      </div>
    </div>
    <ul class="platforms">
      {copy.devices.columns.map((platform) => (
        <li>{platform}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    padding: clamp(32px, 4vw, 56px) var(--gutter) clamp(36px, 4vw, 56px);
    background: var(--teal);
    color: #fff;
    text-align: center;
  }

  .ring {
    position: absolute;
    inset-block-start: 60px;
    inset-inline-start: -90px;
    inline-size: 260px;
    block-size: 260px;
    border: 44px solid var(--teal-ring);
    border-radius: 50%;
  }

  .dot {
    position: absolute;
    border-radius: 50%;
  }

  .coral {
    inset-block-start: 48%;
    inset-inline-end: 7%;
    inline-size: 20px;
    block-size: 20px;
    background: var(--coral);
  }

  .amber {
    inset-block-start: 12%;
    inset-inline-end: 13%;
    inline-size: 14px;
    block-size: 14px;
    background: var(--amber);
  }

  @media (max-width: 600px) {
    .dot {
      display: none;
    }
  }

  .intro {
    position: relative;
    max-inline-size: 900px;
    margin-inline: auto;
  }

  .pill {
    display: inline-block;
    padding: 4px 16px;
    border: 1.5px solid #bfe6de;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .kicker {
    margin-block-start: 18px;
    color: #ffe9b8;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1rem + 0.9vw, 1.75rem);
    font-weight: 700;
    line-height: 1.4;
  }

  h1 {
    margin-block-start: 6px;
    font-size: var(--text-h1);
    line-height: 1.3;
  }

  h1 span {
    display: inline-block;
  }

  :lang(en) h1 {
    line-height: 1.12;
  }

  .lead {
    max-inline-size: 38em;
    margin: 16px auto 24px;
    color: var(--on-teal-soft);
    font-size: var(--text-lead);
  }

  .reassure {
    margin-block-start: 12px;
    color: var(--on-teal-soft);
    font-size: 0.9375rem;
  }

  .reassure a {
    display: inline-block;
    padding-block: 6px;
    color: #fff;
    font-weight: 700;
  }

  /* The devices cross the edge of the colour band. */
  .devices {
    padding: 8px var(--gutter) 0;
    background: linear-gradient(var(--teal) 0 44%, var(--ground) 44%);
  }

  .stage {
    position: relative;
    max-inline-size: 1020px;
    margin-inline: auto;
    padding-block-end: 3%;
  }

  .laptop {
    inline-size: 80%;
    margin-inline: auto;
  }

  .lid {
    padding: clamp(4px, 0.8vw, 10px);
    border-radius: clamp(8px, 1.4vw, 16px) clamp(8px, 1.4vw, 16px) 0 0;
    background: var(--bezel);
    box-shadow: var(--shadow-phone);
  }

  .lid :global(img) {
    inline-size: 100%;
    border-radius: clamp(3px, 0.6vw, 6px);
  }

  .base {
    block-size: clamp(6px, 1.1vw, 14px);
    margin-inline: -4%;
    border-radius: 0 0 clamp(6px, 1.2vw, 14px) clamp(6px, 1.2vw, 14px);
    background: #3a342e;
  }

  .iphone,
  .android {
    position: absolute;
    inset-block-end: 0;
    inline-size: 24%;
  }

  .iphone {
    inset-inline-start: 0;
  }

  .android {
    inset-inline-end: 0;
    inline-size: 23%;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    justify-content: center;
    padding-block-start: 16px;
    font-weight: 700;
  }

  .platforms li:not(:last-child)::after {
    margin-inline-start: 12px;
    color: var(--muted);
    content: "/";
  }
</style>
