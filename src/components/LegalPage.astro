---
import type { Copy } from "../i18n/ja";
import Base from "../layouts/Base.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  copy: Copy;
  title: string;
  /** Shown above the text while the page is a placeholder. */
  draftNotice?: string;
  alternates: { ja: string; en: string };
}

const { copy, title, draftNotice, alternates } = Astro.props;
// The app's policy titles already carry the name (「おたよりん プライバシーポリシー」).
const documentTitle = title.includes(copy.siteName) ? title : `${title} | ${copy.siteName}`;
---

<Base copy={copy} title={documentTitle} description={title} alternates={alternates} noindex>
  <Header copy={copy} />
  <main id="main" class="legal">
    <h1>{title}</h1>
    {draftNotice && <p class="draft">{draftNotice}</p>}
    <slot />
  </main>
  <Footer footer={copy.footer} />
</Base>

<style>
  .legal {
    max-inline-size: 720px;
    margin-inline: auto;
    padding: 48px var(--gutter) 72px;
  }

  h1 {
    font-size: var(--text-h2);
  }

  .draft {
    margin-block: 16px 32px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--amber-soft);
    color: var(--amber-ink);
    font-weight: 500;
  }

  .legal :global(h2) {
    margin-block: 32px 8px;
    font-size: 1.375rem;
  }

  .legal :global(ul) {
    padding-inline-start: 1.25em;
    list-style: disc;
  }

  .legal :global(li + li) {
    margin-block-start: 6px;
  }
</style>
