---
import headingFont from "../assets/fonts/zen-maru-gothic-subset.woff2?url";
import "../styles/tokens.css";
import "../styles/base.css";
import { SITE_URL, APP_STORE_ID, withBase } from "../config";
import type { Copy } from "../i18n/ja";

interface Props {
  copy: Copy;
  title?: string;
  description?: string;
  /** This page's path in each language. Omit on pages with no translation. */
  alternates?: { ja: string; en: string };
  noindex?: boolean;
  /** The title link previews show. Defaults to the home page's share title. */
  ogTitle?: string;
  /** A stricter referrer policy than the site's header, e.g. "no-referrer" on the send page. */
  referrer?: string;
  /** A Content-Security-Policy for this page, on top of the site's header. Built pages only: dev injects inline code. */
  csp?: string;
}

const {
  copy,
  title = copy.meta.title,
  description = copy.meta.description,
  alternates,
  noindex = false,
  ogTitle = copy.meta.ogTitle,
  referrer,
  csp,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(withBase(copy.meta.ogImage), SITE_URL).href;
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    {referrer && <meta name="referrer" content={referrer} />}
    {csp && import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "max-image-preview:large"} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="ja" href={new URL(withBase(alternates.ja), SITE_URL).href} />
        <link rel="alternate" hreflang="en" href={new URL(withBase(alternates.en), SITE_URL).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(withBase(alternates.ja), SITE_URL).href} />
      </>
    )}
    <meta name="theme-color" content="#0f766e" />
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.siteName} />
    <meta property="og:locale" content={copy.meta.ogLocale} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy.skip}
    </a>
    <slot />
  </body>
</html>
